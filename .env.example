# 복사해서 .env 로 쓰거나, 셸 환경변수로 직접 지정하세요.
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.

# --- AI ---
# stub | openai
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- 네이버 검색광고 ---
# stub | naver
NAVER_SEARCHAD_PROVIDER=stub
# 검색광고 관리자 > 도구 > API 사용 관리 에서 발급
NAVER_CUSTOMER_ID=
NAVER_API_KEY=
NAVER_SECRET_KEY=
# 일 배치 자동 동기화
NAVER_SYNC_ENABLED=false
NAVER_SYNC_CRON=0 30 5 * * *
NAVER_SYNC_DAYS=30

# --- 입찰가 조정 가드레일 ---
# 0 이면 계정 평균 CPA 를 목표로 삼음
ADS_TARGET_CPA=0
ADS_BID_LOOKBACK_DAYS=14
ADS_BID_MIN_IMPRESSIONS=100
# 1회 조정 상한 (0.2 = ±20%)
ADS_BID_MAX_CHANGE_RATE=0.2
ADS_BID_MIN=70
ADS_BID_MAX=100000
ADS_BID_MAX_DAILY_APPLIES=50
# true 면 승인해도 네이버에 반영하지 않고 기록만 남김. 실계정 첫 연결 시 권장
ADS_BID_DRY_RUN=false

# --- DB (미지정 시 H2 파일 모드) ---
# DB_URL=jdbc:mysql://localhost:3306/marketing_agent?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=marketing
# DB_PASSWORD=
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# FLYWAY_ENABLED=true
# JPA_DDL_AUTO=validate
