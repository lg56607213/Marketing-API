# 복사해서 .env 로 쓰거나, 셸 환경변수로 직접 지정하세요.
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.

# --- AI ---
# stub | openai
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- 보안 ---
# 운영에서는 둘 다 반드시 바꾸세요. APP_ENCRYPTION_KEY 는 DB 에 저장하는 광고 API 비밀키를 암호화합니다.
# 바꾸면 이미 저장한 비밀키를 읽을 수 없으니, 정한 뒤에는 유지하세요. 미지정 시 JWT_SECRET 을 씁니다.
# JWT_SECRET=
# APP_ENCRYPTION_KEY=

# --- 네이버 검색광고 ---
# 광고 계정은 화면의 「광고 계정 관리」에서 업체별로 여러 개 등록합니다.
# 아래 4개는 첫 기동 때 "기본 업체"의 기본 광고 계정을 만드는 데만 쓰입니다 (없으면 예시 데이터 계정 생성).
# stub | naver
NAVER_SEARCHAD_PROVIDER=stub
NAVER_CUSTOMER_ID=
NAVER_API_KEY=
NAVER_SECRET_KEY=
# 광고 계정 비밀키를 DB 에 암호화하는 키. 비우면 JWT_SECRET 을 쓰지만, 운영에서는 반드시 따로 지정하세요.
# 이 값을 바꾸면 등록된 광고 계정의 비밀키를 다시 넣어야 합니다.
APP_ENCRYPTION_KEY=
# 일 배치 자동 동기화
NAVER_SYNC_ENABLED=false
NAVER_SYNC_CRON=0 30 5 * * *
NAVER_SYNC_DAYS=30
# 시간대별 성과·전환·검색어 리포트를 매일 다시 받을 일수
NAVER_REPORT_SYNC_DAYS=7

# --- 입찰가 조정 가드레일 ---
# 0 이면 계정 평균 CPA 를 목표로 삼음
ADS_TARGET_CPA=0
ADS_BID_LOOKBACK_DAYS=14
ADS_BID_MIN_IMPRESSIONS=100
# 1회 조정 상한 (0.2 = ±20%)
ADS_BID_MAX_CHANGE_RATE=0.2
ADS_BID_MIN=70
ADS_BID_MAX=100000
ADS_BID_MAX_DAILY_APPLIES=50
# true 면 승인해도 네이버에 반영하지 않고 기록만 남김. 실계정 첫 연결 시 권장
ADS_BID_DRY_RUN=false

# --- DB (미지정 시 H2 파일 모드) ---
# DB_URL=jdbc:mysql://localhost:3306/marketing_agent?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=marketing
# DB_PASSWORD=
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# FLYWAY_ENABLED=true
# JPA_DDL_AUTO=validate
